{
    "name": "obsidian-spaced-repetition-flow",
    "version": "1.1.0",
    "description": "Fight the forgetting curve by reviewing flashcards & entire notes.",
    "main": "main.js",
    "scripts": {
        "build": "bun run bundle-css && bun run type-check && bun esbuild.config.mjs production",
        "bundle-css": "bun bundle-css.mjs",
        "type-check": "tsc --noEmit",
        "dev": "bun run bundle-css && bun esbuild.config.mjs",
        "format": "bun prettier --write . && bun eslint src/ tests/ --fix",
        "lint": "bun prettier --check . && bun eslint src/ tests/",
        "test": "bun test",
        "test:failed": "bun test --bail",
        "test:watch": "bun test --watch",
        "test:file": "bun test",
        "validate": "concurrently --kill-others-on-fail -g -p \"[{name}]\" -n \"format,lint,test\" \"bun:format\" \"bun:lint\" \"bun:test\"",
        "precommit-msg": "echo 'Pre-commit checks...'",
        "changelog": "bun auto-changelog --template=compact --package && bun prettier --write docs/docs/changelog.md"
    },
    "keywords": [
        "obsidian",
        "spaced-repetition",
        "flashcards"
    ],
    "author": "Riffaells",
    "license": "MIT",
    "devDependencies": {
        "@popperjs/core": "^2.11.8",
        "@types/jest": "^29.5.12",
        "@types/jsdom": "^27.0.0",
        "@types/node": "^20.16.2",
        "@types/vhtml": "^2.2.9",
        "@typescript-eslint/eslint-plugin": "^6.21.0",
        "@typescript-eslint/parser": "^6.21.0",
        "auto-changelog": "^2.5.0",
        "builtin-modules": "^4.0.0",
        "chai": "^4.5.0",
        "deepcopy": "^2.1.0",
        "esbuild": "^0.27.0",
        "eslint": "^8.57.0",
        "fast-check": "^4.5.2",
        "happy-dom": "^20.0.11",
        "jest": "^29.7.0",
        "jest-environment-jsdom": "^29.7.0",
        "jest-expect-message": "^1.1.3",
        "jsdom": "^27.4.0",
        "moment": "^2.30.1",
        "obsidian": "^1.6.6",
        "prettier": "^3.3.3",
        "ts-fsrs": "^5.2.1",
        "ts-jest": "^29.2.5",
        "tslib": "2.6.1",
        "typescript": "5.1.6",
        "vhtml": "^2.2.0"
    },
    "dependencies": {
        "chart.js": "^4.4.8",
        "clozecraft": "^0.4.0",
        "gridjs": "^6.2.0",
        "minimatch": "^10.0.1",
        "pagerank.js": "^1.0.2",
        "short-uuid": "^5.2.0"
    },
    "pre-commit": [
        "precommit-msg",
        "validate"
    ],
    "packageManager": "bun@1.0.0"
}
